# Copy to backend/.env for local dev (cp .env.example backend/.env).
# Staging/production: set these in the hosting provider's secret manager,
# never commit real values. See docs/ENVIRONMENTS.md.

# --- App ---
NODE_ENV=development            # development | staging | production
PORT=3000
# Comma-separated browser origins allowed to call the API. If unset, development allows
# http://localhost:5173 and staging/production allow none.
CORS_ORIGINS=

# --- Database (matches infra/docker/docker-compose.dev.yml) ---
DATABASE_URL=postgresql://app:app@localhost:5433/studentapp

# --- Auth (REQUIRED; must be strong, unique values in staging/production) ---
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me

# --- Third-party providers (optional locally) ---
EMAIL_PROVIDER_API_KEY=
STORAGE_PROVIDER_KEY=
OCR_PROVIDER_KEY=
LLM_PROVIDER_API_KEY=
SENTRY_DSN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Documents / antivirus ---
DOCUMENTS_MAX_UPLOAD_MB=20
ANTIVIRUS_MODE=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=60000

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3000
